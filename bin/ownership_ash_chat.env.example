# Prod env for the migrate step run by bin/release.sh.
# Copy to .env.prod on the server (next to the project root, gitignored) and
# keep the values in sync with bin/ownership_ash_chat.ini.
#
# These mirror what runtime.exs requires in :prod for any release command.
export MIX_ENV=prod
export DATABASE_URL="ecto://USER:PASS@127.0.0.1/ownership_ash_chat_prod"
export SECRET_KEY_BASE="!! generate with: mix phx.gen.secret !!"
export TOKEN_SIGNING_SECRET="!! generate with: mix phx.gen.secret !!"
