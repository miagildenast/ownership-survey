[program:ownership_ash_chat]
command=/bin/bash ./server
directory=/home/USER/ownership_ash_chat/_build/prod/rel/ownership_ash_chat/bin
environment=
    MIX_ENV="prod",
    PORT=4001,
    PHX_HOST=USER.uber.space,
    DATABASE_PATH=/home/USER/ownership_ash_chat/ownership_ash_chat_prod.db,
    SECRET_KEY_BASE="!! generate with: mix phx.gen.secret !!",
    TOKEN_SIGNING_SECRET="!! generate with: mix phx.gen.secret !!",
    OPENROUTER_API_KEY="!! your OpenRouter API key !!",
    LLM_MODEL="openai/gpt-oss-120b:free",
    LLM_BASE_URL="https://openrouter.ai/api/v1"
    # SQLite is built against uberspace's system lib at deploy time
    # (see bin/install.sh: EXQLITE_USE_SYSTEM). No runtime EXQLITE env needed.
autostart=yes
autorestart=yes
