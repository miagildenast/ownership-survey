<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-xl py-16 text-center">
    <h1 class="text-2xl font-semibold">Session started</h1>
    <p class="mt-4 text-base-content/70">
      Keep this ID to return your results to the originating tool:
    </p>
    <p class="mt-2 font-mono text-lg">{@session_id}</p>
  </div>
</Layouts.app>
